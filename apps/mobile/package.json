{
  "name": "@uln/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "build:preview:ios": "eas build --platform ios --profile preview --non-interactive",
    "build:preview:android": "eas build --platform android --profile preview --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production --non-interactive",
    "submit:android": "eas submit --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@sentry/react-native": "^6.14.0",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
