# Production API — set to your Railway URL after deploy
# EXPO_PUBLIC_API_URL=https://your-app.up.railway.app/api/v1

# Local dev — use your machine LAN IP when testing on a physical phone
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional error monitoring
# EXPO_PUBLIC_SENTRY_DSN=

# Set automatically by `eas init` — do not edit manually unless you know the ID
# EAS_PROJECT_ID=
