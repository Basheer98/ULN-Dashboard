# Production API — set to your Railway URL after deploy (required for store builds)
# Prefer setting this in expo.dev → Project → Environment variables for preview/production.
# EXPO_PUBLIC_API_URL=https://your-app.up.railway.app/api/v1

# Local dev — use your machine LAN IP when testing on a physical phone
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional error monitoring
# EXPO_PUBLIC_SENTRY_DSN=

# Written by `eas init` — required for production push tokens + EAS builds
# EAS_PROJECT_ID=

# App Store submit (eas.json submit.production.ios)
# APPLE_TEAM_ID=          # 10-char Team ID from developer.apple.com → Membership
# ASC_APP_ID=             # numeric App Store Connect app id

# Play Console: place service account JSON at apps/mobile/google-play-service-account.json
# (gitignored) then run: npm run submit:android
