# PostgreSQL — local Docker or Railway public URL for dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uln_dashboard?schema=public"

# Auth secrets — generate with: openssl rand -base64 32
JWT_SECRET="change-me-jwt-secret-min-32-chars"
SESSION_SECRET="change-me-session-secret-min-32-chars"

# Web app URL (local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mobile app — point Expo at local API (use your machine IP on physical device)
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Railway Storage Bucket (optional for local dev — uses ./uploads folder when unset)
# STORAGE_ENDPOINT=
# BUCKET_ACCESS_KEY=
# BUCKET_SECRET_KEY=
# BUCKET_NAME=

# Receipt storage — local dev uses ./uploads; production uses Google Drive
# STORAGE_PROVIDER=local
# STORAGE_PROVIDER=google_drive
# GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=

# Option A (local dev): path to service account JSON from Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option B (Railway/production): inline credentials as env vars
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Receipt OCR (Cloud Vision) — same service account as above
# 1. Enable Cloud Vision API on that GCP project
# 2. Enable BILLING on the project (required even for free-tier Vision usage)
#    https://console.cloud.google.com/billing/enable?project=YOUR_PROJECT_ID
# 3. Restart the Next.js server after enabling

# Google Sheets project tracker sync (optional — uses same service account as Drive)
# 1. Enable Google Sheets API in Google Cloud for your project
# 2. Share the spreadsheet with your service account email as Viewer
# 3. Paste the spreadsheet ID (from the URL) below
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_TAB_NAME=Sheet1
# GOOGLE_SHEETS_RANGE=
# Share the sheet as Editor for write-back. Set to "false" to disable push.
# GOOGLE_SHEETS_WRITE_BACK=true

# Mileage odometer photos use the same Drive root. The app auto-creates:
#   mileage/{Fielder-Name}/{YYYY-MM}/date_fielder_project_start|end_reading.jpg
# No extra folder ID needed if GOOGLE_DRIVE_RECEIPTS_FOLDER_ID is already set.

# Use a Shared Drive (Google Workspace): create drive, add SA as Content manager, use that folder ID.
# Also share the target folder with the service account email as Editor.

# Office email notifications (optional — logs to console in dev without Resend)
# RESEND_API_KEY=
# EMAIL_FROM="ULN Dashboard <notifications@yourdomain.com>"
# OFFICE_NOTIFICATION_EMAIL="ops@yourdomain.com"

# Error monitoring (optional — disabled when unset)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=

# ─── Railway production (set in Railway dashboard, not in git) ───
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# See DEPLOYMENT.md for full Railway + app store checklist
