generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  dispatcher
  accountant
  fielder
}

enum EmploymentType {
  contractor_1099
  w2
}

enum ProjectStatus {
  draft
  assigned
  in_progress
  complete
  invoiced
  paid
  cancelled
}

enum AssignmentStatus {
  assigned
  accepted
  in_progress
  complete
  cancelled
}

enum LineItemType {
  client_billing
  fielder_payout
}

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  overdue
}

enum PaymentStatus {
  pending
  approved
  paid
}

enum AttachmentType {
  photo
  document
  as_built
  other
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(admin)
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  fielderId    String?   @unique @map("fielder_id")
  fielder      Fielder?  @relation(fields: [fielderId], references: [id])
  pushToken    String?   @map("push_token")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projectsCreated Project[]      @relation("ProjectCreator")
  attachments     Attachment[]
  activityLogs    ActivityLog[]
  financeTransactionsCreated FinancialTransaction[] @relation("FinanceTransactionCreator")
  financeTransactionsReviewed FinancialTransaction[] @relation("FinanceTransactionReviewer")
  receiptsUploaded Receipt[]
  mileagePhotosUploaded MileagePhoto[]
  financeAuditLogs FinancialAuditLog[]
  mileageEntries   MileageEntry[]
  notifications    Notification[]

  @@map("users")
}

model Client {
  id              String    @id @default(cuid())
  name            String
  contactName     String?   @map("contact_name")
  email           String?
  phone           String?
  defaultSqftRate Decimal   @default(0) @map("default_sqft_rate") @db.Decimal(10, 4)
  billingTerms    String?   @map("billing_terms")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  projects Project[]
  invoices Invoice[]
  financeTransactions FinancialTransaction[]

  @@map("clients")
}

model Fielder {
  id              String         @id @default(cuid())
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  phone           String?
  email           String?
  employmentType  EmploymentType @default(contractor_1099) @map("employment_type")
  defaultSqftRate Decimal        @default(0) @map("default_sqft_rate") @db.Decimal(10, 4)
  region          String?
  skills          String[]       @default([])
  certifications  String[]       @default([])
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user           User?
  assignments    Assignment[]
  lineItems      ProjectLineItem[]
  payments       FielderPayment[]
  financeTransactions FinancialTransaction[]
  mileageEntries MileageEntry[]

  @@map("fielders")
}

model StateRate {
  id              String   @id @default(cuid())
  state           String   @unique
  clientSqftRate  Decimal  @map("client_sqft_rate") @db.Decimal(10, 4)
  fielderSqftRate Decimal  @map("fielder_sqft_rate") @db.Decimal(10, 4)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("state_rates")
}

model Project {
  id             String        @id @default(cuid())
  projectNumber  String        @unique @map("project_number")
  clientId       String        @map("client_id")
  client         Client        @relation(fields: [clientId], references: [id])
  title          String
  siteAddress    String        @map("site_address")
  city           String?
  state          String?
  zip            String?
  jobType        String?       @map("job_type")
  qfield         Int?          @map("qfield")
  description    String?
  sqft           Decimal       @default(0) @db.Decimal(12, 2)
  clientSqftRate Decimal       @default(0) @map("client_sqft_rate") @db.Decimal(10, 4)
  status         ProjectStatus @default(draft)
  dueDate        DateTime?     @map("due_date")
  completedAt    DateTime?     @map("completed_at")
  notes          String?
  createdById    String?       @map("created_by_id")
  createdBy      User?         @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lineItems   ProjectLineItem[]
  assignments Assignment[]
  invoices    Invoice[]
  payments    FielderPayment[]
  attachments Attachment[]
  financeTransactions FinancialTransaction[]
  expenseAllocations ExpenseAllocation[]
  trips       TripProject[]

  @@index([clientId, status])
  @@index([status, dueDate])
  @@map("projects")
}

model ProjectLineItem {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        LineItemType
  description String
  amount      Decimal      @db.Decimal(12, 2)
  fielderId   String?      @map("fielder_id")
  fielder     Fielder?     @relation(fields: [fielderId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("project_line_items")
}

model Assignment {
  id              String           @id @default(cuid())
  projectId       String           @map("project_id")
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fielderId       String           @map("fielder_id")
  fielder         Fielder          @relation(fields: [fielderId], references: [id])
  assignedSqft    Decimal          @default(0) @map("assigned_sqft") @db.Decimal(12, 2)
  fielderSqftRate Decimal          @default(0) @map("fielder_sqft_rate") @db.Decimal(10, 4)
  status          AssignmentStatus @default(assigned)
  assignedAt      DateTime         @default(now()) @map("assigned_at")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  notes           String?

  @@unique([projectId, fielderId])
  @@index([fielderId, status])
  @@map("assignments")
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique @map("invoice_number")
  projectId       String        @map("project_id")
  project         Project       @relation(fields: [projectId], references: [id])
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])
  sqftAmount      Decimal       @default(0) @map("sqft_amount") @db.Decimal(12, 2)
  lineItemsTotal  Decimal       @default(0) @map("line_items_total") @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status          InvoiceStatus @default(draft)
  issuedAt        DateTime?     @map("issued_at")
  dueAt           DateTime?     @map("due_at")
  paidAt          DateTime?     @map("paid_at")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invoicePayments InvoicePayment[]
  financeTransactions FinancialTransaction[]

  @@index([status, dueAt])
  @@map("invoices")
}

model FielderPayment {
  id              String          @id @default(cuid())
  fielderId       String          @map("fielder_id")
  fielder         Fielder         @relation(fields: [fielderId], references: [id])
  projectId       String?         @map("project_id")
  project         Project?        @relation(fields: [projectId], references: [id])
  sqftAmount      Decimal         @default(0) @map("sqft_amount") @db.Decimal(12, 2)
  lineItemsTotal  Decimal         @default(0) @map("line_items_total") @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  employmentType  EmploymentType  @map("employment_type")
  status          PaymentStatus   @default(pending)
  paidAt          DateTime?       @map("paid_at")
  paymentMethod   String?         @map("payment_method")
  referenceNumber String?         @map("reference_number")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([fielderId, status])
  @@map("fielder_payments")
}

model Attachment {
  id          String         @id @default(cuid())
  projectId   String         @map("project_id")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String?       @map("uploaded_by_id")
  uploadedBy  User?          @relation(fields: [uploadedById], references: [id])
  fileKey     String         @map("file_key")
  fileName    String         @map("file_name")
  mimeType    String         @map("mime_type")
  size        Int
  type        AttachmentType @default(photo)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("attachments")
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("activity_logs")
}

enum NotificationType {
  job_started
  job_completed
  expense_submitted
  mileage_submitted
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  href       String?
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  readAt     DateTime?        @map("read_at")
  resolvedAt DateTime?        @map("resolved_at")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Finance Module ─────────────────────────────────────────────────────────

enum FinanceTransactionType {
  expense
  income
  owner_draw
  owner_contribution
  loan_payment
  loan_proceeds
  transfer
  reimbursement_payout
}

enum ExpenseStatus {
  draft
  submitted
  pending_review
  approved
  rejected
  paid
  reimbursed
  voided
}

enum IncomeCategory {
  client_payment
  advance_payment
  partial_invoice_payment
  travel_reimbursement
  expense_reimbursement
  loan_proceeds
  owner_contribution
  refund_received
  other_income
}

enum ReceiptVerificationStatus {
  pending
  verified
  rejected
}

enum TripStatus {
  planned
  active
  completed
  cancelled
}

enum ReconciliationStatus {
  in_progress
  balanced
  completed
  reopened
}

enum LoanStatus {
  active
  paid_off
  defaulted
  cancelled
}

enum PaidByType {
  company
  employee
}

model FinancialSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("financial_settings")
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  subcategories ExpenseSubcategory[]
  transactions  FinancialTransaction[]
  vendors       Vendor[]

  @@map("expense_categories")
}

model ExpenseSubcategory {
  id         String          @id @default(cuid())
  categoryId String          @map("category_id")
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int             @default(0) @map("sort_order")
  isActive   Boolean         @default(true) @map("is_active")

  transactions FinancialTransaction[]

  @@unique([categoryId, name])
  @@map("expense_subcategories")
}

model PaymentMethod {
  id                  String   @id @default(cuid())
  name                String
  type                String
  accountNickname     String?  @map("account_nickname")
  lastFour            String?  @map("last_four")
  openingBalance      Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance      Decimal  @default(0) @map("current_balance") @db.Decimal(14, 2)
  includeInDashboard  Boolean  @default(true) @map("include_in_dashboard")
  isActive            Boolean  @default(true) @map("is_active")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  transactions       FinancialTransaction[]
  reconciliations    BankReconciliation[]
  vendors            Vendor[]

  @@map("payment_methods")
}

model Vendor {
  id                  String           @id @default(cuid())
  name                String
  vendorType          String           @map("vendor_type")
  contactName         String?          @map("contact_name")
  email               String?
  phone               String?
  address             String?
  taxId               String?          @map("tax_id")
  defaultCategoryId   String?          @map("default_category_id")
  defaultCategory     ExpenseCategory? @relation(fields: [defaultCategoryId], references: [id])
  defaultPaymentMethodId String?       @map("default_payment_method_id")
  defaultPaymentMethod PaymentMethod?  @relation(fields: [defaultPaymentMethodId], references: [id])
  notes               String?
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  transactions FinancialTransaction[]

  @@map("vendors")
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  make      String?
  model     String?
  year      Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  mileageEntries MileageEntry[]

  @@map("vehicles")
}

model Trip {
  id        String     @id @default(cuid())
  name      String
  startDate DateTime?  @map("start_date")
  endDate   DateTime?  @map("end_date")
  state     String?
  city      String?
  purpose   String?
  budget    Decimal?   @db.Decimal(14, 2)
  status    TripStatus @default(planned)
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  projects     TripProject[]
  transactions FinancialTransaction[]
  mileageEntries MileageEntry[]

  @@map("trips")
}

model TripProject {
  id        String  @id @default(cuid())
  tripId    String  @map("trip_id")
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([tripId, projectId])
  @@map("trip_projects")
}

model FinancialTransaction {
  id                String                 @id @default(cuid())
  transactionNumber String                 @unique @map("transaction_number")
  transactionType   FinanceTransactionType @map("transaction_type")
  transactionDate   DateTime               @map("transaction_date")
  amount            Decimal                @db.Decimal(14, 2)
  currency          String                 @default("USD")
  description       String?
  businessPurpose   String?                @map("business_purpose")
  categoryId        String?                @map("category_id")
  category          ExpenseCategory?       @relation(fields: [categoryId], references: [id])
  subcategoryId     String?                @map("subcategory_id")
  subcategory       ExpenseSubcategory?    @relation(fields: [subcategoryId], references: [id])
  paymentMethodId   String?                @map("payment_method_id")
  paymentMethod     PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  projectId         String?                @map("project_id")
  project           Project?               @relation(fields: [projectId], references: [id])
  fielderId         String?                @map("fielder_id")
  fielder           Fielder?               @relation(fields: [fielderId], references: [id])
  clientId          String?                @map("client_id")
  client            Client?                @relation(fields: [clientId], references: [id])
  invoiceId         String?                @map("invoice_id")
  invoice           Invoice?               @relation(fields: [invoiceId], references: [id])
  vendorId          String?                @map("vendor_id")
  vendor            Vendor?                @relation(fields: [vendorId], references: [id])
  tripId            String?                @map("trip_id")
  trip              Trip?                  @relation(fields: [tripId], references: [id])
  workState         String?                @map("work_state")
  status            String?
  expenseStatus     ExpenseStatus?         @map("expense_status")
  incomeCategory    IncomeCategory?        @map("income_category")
  paidBy            PaidByType?            @map("paid_by")
  cardLastFour      String?                @map("card_last_four")
  isReimbursable    Boolean                @default(false) @map("is_reimbursable")
  isBillable        Boolean                @default(false) @map("is_billable")
  isTaxDeductible   Boolean                @default(true) @map("is_tax_deductible")
  paymentReference  String?                @map("payment_reference")
  notes             String?
  submittedById     String?                @map("submitted_by_id")
  reviewedById      String?                @map("reviewed_by_id")
  reviewedBy        User?                  @relation("FinanceTransactionReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewReason      String?                @map("review_reason")
  reimbursedAt      DateTime?              @map("reimbursed_at")
  createdById       String?                @map("created_by_id")
  createdBy         User?                  @relation("FinanceTransactionCreator", fields: [createdById], references: [id])
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")

  allocations         ExpenseAllocation[]
  receipts            Receipt[]
  invoicePayments     InvoicePayment[]
  reconciliationItems ReconciliationItem[]
  loanPayments        LoanPayment[]

  @@index([transactionType, transactionDate])
  @@index([expenseStatus])
  @@index([projectId])
  @@index([fielderId])
  @@index([workState])
  @@index([deletedAt])
  @@map("financial_transactions")
}

model ExpenseAllocation {
  id            String               @id @default(cuid())
  transactionId String               @map("transaction_id")
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  projectId     String               @map("project_id")
  project       Project              @relation(fields: [projectId], references: [id])
  amount        Decimal              @db.Decimal(14, 2)
  percent       Decimal?             @db.Decimal(5, 2)

  @@map("expense_allocations")
}

model Receipt {
  id                 String                    @id @default(cuid())
  transactionId      String?                   @map("transaction_id")
  transaction        FinancialTransaction?     @relation(fields: [transactionId], references: [id])
  originalFileName   String                    @map("original_file_name")
  storedFileName     String                    @map("stored_file_name")
  mimeType           String                    @map("mime_type")
  fileSize           Int                       @map("file_size")
  storageProvider    String                    @default("local") @map("storage_provider")
  storageFileId      String?                   @map("storage_file_id")
  storageUrl         String?                   @map("storage_url")
  fileHash           String?                   @map("file_hash")
  verificationStatus ReceiptVerificationStatus @default(pending) @map("verification_status")
  projectId          String?                   @map("project_id")
  vendorId           String?                   @map("vendor_id")
  uploadedById       String?                   @map("uploaded_by_id")
  uploadedBy         User?                     @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime                  @default(now()) @map("created_at")
  deletedAt          DateTime?                 @map("deleted_at")

  @@index([fileHash])
  @@index([transactionId])
  @@map("receipts")
}

model InvoicePayment {
  id            String               @id @default(cuid())
  invoiceId     String               @map("invoice_id")
  invoice       Invoice              @relation(fields: [invoiceId], references: [id])
  transactionId String               @map("transaction_id")
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])
  amount        Decimal              @db.Decimal(14, 2)
  paidAt        DateTime             @map("paid_at")
  reference     String?
  createdAt     DateTime             @default(now()) @map("created_at")

  @@map("invoice_payments")
}

model MileageEntry {
  id               String   @id @default(cuid())
  date             DateTime
  driverId         String   @map("driver_id")
  driver           Fielder  @relation(fields: [driverId], references: [id])
  vehicleId        String?  @map("vehicle_id")
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id])
  startLocation    String?  @map("start_location")
  destination      String?
  startOdometer    Decimal? @map("start_odometer") @db.Decimal(10, 1)
  endOdometer      Decimal? @map("end_odometer") @db.Decimal(10, 1)
  totalMiles       Decimal  @map("total_miles") @db.Decimal(10, 1)
  businessPurpose  String?  @map("business_purpose")
  projectId        String?  @map("project_id")
  tripId           String?  @map("trip_id")
  trip             Trip?    @relation(fields: [tripId], references: [id])
  isReimbursable   Boolean  @default(true) @map("is_reimbursable")
  mileageRate      Decimal  @map("mileage_rate") @db.Decimal(10, 4)
  reimbursement    Decimal  @db.Decimal(14, 2)
  status           ExpenseStatus @default(submitted)
  notes            String?
  submittedById    String?  @map("submitted_by_id")
  submittedBy      User?    @relation(fields: [submittedById], references: [id])
  photos           MileagePhoto[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([driverId, date])
  @@map("mileage_entries")
}

enum MileagePhotoKind {
  start_odometer
  end_odometer
}

model MileagePhoto {
  id               String           @id @default(cuid())
  mileageEntryId   String?          @map("mileage_entry_id")
  mileageEntry     MileageEntry?    @relation(fields: [mileageEntryId], references: [id], onDelete: Cascade)
  kind             MileagePhotoKind
  originalFileName String           @map("original_file_name")
  storedFileName   String           @map("stored_file_name")
  mimeType         String           @map("mime_type")
  fileSize         Int              @map("file_size")
  storageProvider  String           @default("local") @map("storage_provider")
  storageFileId    String?          @map("storage_file_id")
  storageUrl       String?          @map("storage_url")
  fileHash         String?          @map("file_hash")
  uploadedById     String?          @map("uploaded_by_id")
  uploadedBy       User?            @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  deletedAt        DateTime?        @map("deleted_at")

  @@index([mileageEntryId])
  @@index([fileHash])
  @@map("mileage_photos")
}

model BankReconciliation {
  id               String               @id @default(cuid())
  paymentMethodId  String               @map("payment_method_id")
  paymentMethod    PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  statementDate    DateTime             @map("statement_date")
  startingBalance  Decimal              @map("starting_balance") @db.Decimal(14, 2)
  endingBalance    Decimal              @map("ending_balance") @db.Decimal(14, 2)
  clearedTotal     Decimal              @default(0) @map("cleared_total") @db.Decimal(14, 2)
  difference       Decimal              @default(0) @db.Decimal(14, 2)
  status           ReconciliationStatus @default(in_progress)
  notes            String?
  completedAt      DateTime?            @map("completed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  items ReconciliationItem[]

  @@map("bank_reconciliations")
}

model ReconciliationItem {
  id               String               @id @default(cuid())
  reconciliationId String               @map("reconciliation_id")
  reconciliation   BankReconciliation   @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transactionId    String?              @map("transaction_id")
  transaction      FinancialTransaction? @relation(fields: [transactionId], references: [id])
  description      String?
  amount           Decimal              @db.Decimal(14, 2)
  transactionDate  DateTime?            @map("transaction_date")
  isCleared        Boolean              @default(false) @map("is_cleared")
  isManual         Boolean              @default(false) @map("is_manual")

  @@map("reconciliation_items")
}

model Loan {
  id              String     @id @default(cuid())
  lender          String
  originalAmount  Decimal    @map("original_amount") @db.Decimal(14, 2)
  remainingBalance Decimal   @map("remaining_balance") @db.Decimal(14, 2)
  interestRate    Decimal?   @map("interest_rate") @db.Decimal(6, 4)
  startDate       DateTime?  @map("start_date")
  paymentFrequency String?   @map("payment_frequency")
  paymentAmount   Decimal?   @map("payment_amount") @db.Decimal(14, 2)
  nextPaymentDate DateTime? @map("next_payment_date")
  purpose         String?
  status          LoanStatus @default(active)
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  payments LoanPayment[]

  @@map("loans")
}

model LoanPayment {
  id              String               @id @default(cuid())
  loanId          String               @map("loan_id")
  loan            Loan                 @relation(fields: [loanId], references: [id])
  transactionId   String?              @map("transaction_id")
  transaction     FinancialTransaction? @relation(fields: [transactionId], references: [id])
  paidAt          DateTime             @map("paid_at")
  principalAmount Decimal              @default(0) @map("principal_amount") @db.Decimal(14, 2)
  interestAmount  Decimal              @default(0) @map("interest_amount") @db.Decimal(14, 2)
  feeAmount       Decimal              @default(0) @map("fee_amount") @db.Decimal(14, 2)
  totalAmount     Decimal              @map("total_amount") @db.Decimal(14, 2)
  reference       String?
  createdAt       DateTime             @default(now()) @map("created_at")

  @@map("loan_payments")
}

model FinancialAuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("financial_audit_logs")
}
