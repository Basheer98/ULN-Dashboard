{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run db:generate && npm run build --workspace=@uln/web"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@uln/web",
    "preDeployCommand": "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
